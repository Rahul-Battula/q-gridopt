# Copy this file to backend\.env and fill in real values.
# backend\.env is gitignored. NEVER commit real credentials.
#   copy backend\.env.example backend\.env

# IBM Quantum Platform API key (https://quantum.cloud.ibm.com -> API key)
IBM_QUANTUM_API_KEY=your-ibm-api-key-here

# IBM Quantum instance CRN (crn:v1:bluemix:public:quantum-computing:...)
IBM_QUANTUM_INSTANCE_CRN=your-instance-crn-here

# Channel for QiskitRuntimeService
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
